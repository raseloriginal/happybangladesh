Options -MultiViews

# ── PWA: MIME types ───────────────────────────────────────────
# Serve .webmanifest with the correct MIME type (fallback for static files)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript            .js
</IfModule>

# ── PWA: Service Worker & Manifest headers ────────────────────
# Wrapped in IfModule so the .htaccess doesn't crash on shared
# hosts where mod_headers is disabled.
<IfModule mod_headers.c>
  # Prevent SW scripts from being cached by the browser
  <FilesMatch "^(sr|dsr)-sw(-register)?\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Prevent manifest files from being cached
  <FilesMatch "\.(webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # PHP-generated manifests also must not be cached
  <FilesMatch "^(sr|dsr)-manifest\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Browser Caching Rules for Static Assets ─────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Fallback explicit Cache-Control if mod_expires is disabled
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|ttf|woff|woff2)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>


# ── Routing ───────────────────────────────────────────────────
RewriteEngine On

# Pass PWA static files directly — skip the PHP front controller.
# Note: The RewriteCond !-f below also handles this, but explicit
# rules here make the intent clear and avoid edge cases on some hosts.
RewriteRule ^(sr|dsr)-offline\.html$        - [L,NC]
RewriteRule ^(sr|dsr)\.webmanifest$         - [L,NC]
RewriteRule ^(sr|dsr)-manifest\.php$        - [L,NC]
RewriteRule ^(sr|dsr)-sw(-register)?\.js$   - [L,NC]

# Route everything else through the PHP front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
